# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Auth.js (NextAuth v5) ---
# segreto di sessione: `npx auth secret`
AUTH_SECRET=
# URL pubblica dell'app (es. http://localhost:3000 in dev)
AUTH_URL=
AUTH_TRUST_HOST=true
# login con Google (opzionale)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- LLM providers (almeno uno, usati dall'agente) ---
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=
GLM_VISION_MODEL=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
GEMINI_AGENT_MODEL=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# override elenco modelli dell'agente (opzionale, JSON)
AGENT_MODELS=
# chiave master per cifrare le chiavi BYOK degli utenti (default: AUTH_SECRET)
KEY_ENCRYPTION_SECRET=

# --- Email (magic link): AWS SES ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=
MAIL_FROM=

# --- Widget feedback -> GitHub issues ---
# fine-grained PAT con permesso Issues: Read&Write sul repo (Calandri/pcb-studio)
GITHUB_FEEDBACK_TOKEN=

# --- Mouser (secondo fornitore nella distinta) ---
# chiave gratuita: mouser.it/iot -> "Search API". Senza, il badge Mouser non compare.
MOUSER_API_KEY=

# --- CLI import Altium (scripts/importa-altium.mjs) ---
PCB_STUDIO_TOKEN=
PCB_STUDIO_URL=
