# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Auth.js (NextAuth v5) ---
# segreto di sessione: `npx auth secret`
AUTH_SECRET=
# URL pubblica dell'app (es. http://localhost:3000 in dev)
AUTH_URL=
AUTH_TRUST_HOST=true
# login con Google (opzionale)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Modelli: tutto passa da OpenRouter (model policy 3Bee) ---
# chiave del server, usata quando l'utente o l'organizzazione non hanno una
# chiave OpenRouter propria (BYOK)
OPENROUTER_API_KEY=
# preset OpenRouter, opzionali: SOLO slug di preset (es. 3bee-agent), mai un
# id di modello. Il modello si cambia dalla dashboard OpenRouter.
# default: 3bee-agent (loop dell'agente, solo testo), 3bee-vision (review_layout),
# 3bee-fast (descrizioni dei componenti)
OPENROUTER_AGENT_PRESET=
OPENROUTER_VISION_PRESET=
OPENROUTER_FAST_PRESET=
# budget di token (in + out) di un turno dell'agente (opzionale, default 3000000)
AGENT_MAX_RUN_TOKENS=
# segreto master per cifrare le chiavi BYOK: OBBLIGATORIO in produzione (almeno
# 32 caratteri, es. `openssl rand -base64 48`); in sviluppo ripiega su AUTH_SECRET.
# Cambiarlo rende illeggibili le chiavi salvate: vanno reinserite.
KEY_ENCRYPTION_SECRET=

# --- Email (magic link): AWS SES ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=
MAIL_FROM=

# --- Widget feedback -> GitHub issues ---
# fine-grained PAT con permesso Issues: Read&Write sul repo (Calandri/pcb-studio)
GITHUB_FEEDBACK_TOKEN=

# --- Mouser (secondo fornitore nella distinta) ---
# chiave gratuita: mouser.it/iot -> "Search API". Senza, il badge Mouser non compare.
MOUSER_API_KEY=

# --- CLI import Altium (scripts/importa-altium.mjs) ---
PCB_STUDIO_TOKEN=
PCB_STUDIO_URL=
